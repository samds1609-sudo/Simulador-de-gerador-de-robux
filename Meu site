<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gerador de Robux - Roblox</title>
    <style>
        /* Estilos CSS para deixar o site mais colorido e vibrante */
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            background: linear-gradient(135deg, #1a2a6c, #b21f1f, #fdbb2d); /* Gradiente de azul escuro, vermelho e amarelo */
            color: #ffffff; /* Texto branco */
            text-align: center;
            overflow: hidden; /* Para garantir que o gradiente de fundo ocupe toda a tela */
        }

        .container {
            background-color: rgba(0, 0, 0, 0.75); /* Fundo do container semi-transparente preto */
            padding: 50px 30px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7);
            width: 90%;
            max-width: 450px;
            border: 3px solid #00ff00; /* Borda verde neon */
            animation: pulse-border 2s infinite alternate; /* Animação de pulsar na borda */
        }

        @keyframes pulse-border {
            from { border-color: #00ff00; }
            to { border-color: #00ffff; } /* Verde para ciano */
        }

        h1 {
            color: #ff00ff; /* Magenta vibrante */
            margin-bottom: 35px;
            text-shadow: 0 0 15px #ff00ff, 0 0 25px #ff00ff; /* Sombra neon */
            font-size: 2.5em;
            letter-spacing: 2px;
        }

        label {
            display: block;
            margin-bottom: 15px;
            font-size: 1.2em;
            color: #00ffff; /* Ciano vibrante */
            text-shadow: 0 0 8px #00ffff;
        }

        input[type="text"],
        select {
            width: calc(100% - 24px); /* Ajusta para padding */
            padding: 14px;
            margin-bottom: 30px;
            border: 2px solid #00ff00; /* Borda verde neon */
            border-radius: 10px;
            box-sizing: border-box;
            background-color: #222222; /* Fundo escuro para os inputs */
            color: #ffff00; /* Texto amarelo neon */
            font-size: 1.1em;
            transition: border-color 0.4s, box-shadow 0.4s;
        }

        input[type="text"]:focus,
        select:focus {
            border-color: #ff00ff; /* Magenta ao focar */
            box-shadow: 0 0 15px #ff00ff; /* Sombra neon ao focar */
            outline: none;
        }

        button {
            background: linear-gradient(90deg, #ff0000, #ff8c00, #ffff00); /* Gradiente de vermelho, laranja e amarelo */
            color: white;
            padding: 18px 35px;
            border: none;
            border-radius: 50px;
            cursor: pointer;
            font-size: 1.4em;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 2px;
            box-shadow: 0 5px 20px rgba(255, 0, 0, 0.6);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            z-index: 1;
        }

        button:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(255, 0, 0, 0.8);
        }

        button:active {
            transform: translateY(-1px);
            box-shadow: 0 3px 15px rgba(255, 0, 0, 0.5);
        }

        /* Efeito de brilho no botão */
        button::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: rgba(255, 255, 255, 0.3);
            transform: skewX(-30deg);
            transition: all 0.7s;
            z-index: -1;
        }

        button:hover::before {
            left: 100%;
        }

        #mensagem-geracao {
            margin-top: 25px;
            padding: 18px;
            border-radius: 10px;
            min-height: 25px;
            font-size: 1.2em;
            font-weight: bold;
            color: #ffffff;
            text-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
        }

        /* Estilo para a mensagem de sucesso (simulada) */
        .sucesso {
            background-color: rgba(0, 255, 0, 0.7); /* Verde vibrante semi-transparente */
            box-shadow: 0 0 15px #00ff00;
        }

        /* Estilo para mensagens de processo */
        .processando {
            background-color: rgba(255, 165, 0, 0.7); /* Laranja semi-transparente */
            box-shadow: 0 0 15px #ffa500;
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>Gerador de Robux</h1>

        <form id="geradorForm">
            <label for="nickname">Seu Nickname do Roblox:</label>
            <input type="text" id="nickname" placeholder="Digite seu Nickname" required>

            <label for="quantidade">Quantidade de Robux (100 a 1.000):</label>
            <select id="quantidade" required>
                <option value="100">100 Robux</option>
                <option value="200">200 Robux</option>
                <option value="300">300 Robux</option>
                <option value="400">400 Robux</option>
                <option value="500">500 Robux</option>
                <option value="600">600 Robux</option>
                <option value="700">700 Robux</option>
                <option value="800">800 Robux</option>
                <option value="900">900 Robux</option>
                <option value="1000">1.000 Robux</option>
            </select>

            <button type="submit">GERAR ROBUX</button>
        </form>

        <div id="mensagem-geracao"></div>
    </div>

    <script>
        // Script JavaScript para a funcionalidade de simulação
        document.getElementById('geradorForm').addEventListener('submit', function(event) {
            event.preventDefault(); // Impede o envio real do formulário
            
            const nickname = document.getElementById('nickname').value;
            const quantidade = document.getElementById('quantidade').value;
            const mensagemDiv = document.getElementById('mensagem-geracao');
            
            // Limpa a mensagem anterior
            mensagemDiv.textContent = '';
            mensagemDiv.className = '';

            // Mensagens de simulação com atrasos e cores diferentes
            mensagemDiv.textContent = 'Iniciando conexão com servidores Roblox...';
            mensagemDiv.classList.add('processando');

            setTimeout(() => {
                mensagemDiv.textContent = `Validando conta para o nickname "${nickname}"...`;
            }, 2000); // 2 segundos

            setTimeout(() => {
                mensagemDiv.textContent = `Processando geração de ${quantidade} Robux...`;
            }, 4000); // 4 segundos

            setTimeout(() => {
                mensagemDiv.textContent = `Transferência de ${quantidade} Robux para "${nickname}" CONCLUÍDA!`;
                mensagemDiv.classList.remove('processando');
                mensagemDiv.classList.add('sucesso');
            }, 7000); // 7 segundos
        });
    </script>
</body>
</html>

